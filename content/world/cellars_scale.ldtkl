		{
			"__identifier": "notes",
			"__type": "Multilines",
			"__value": "C02. Cellars stratum (38). Seize the furnace's two roars: heavy, the hall goes dark. Your pan sinks, the far pan rises. Shed a weight to climb; the Copyist's loft; levy the last roar onto the weigh-plate and the round door rolls open.",
			"__tile": null,
			"defUid": 129,
			"realEditorValues": [
				{
					"id": "V_String",
					"params": [
						"C02. Cellars stratum (38). Seize the furnace's two roars: heavy, the hall goes dark. Your pan sinks, the far pan rises. Shed a weight to climb; the Copyist's loft; levy the last roar onto the weigh-plate and the round door rolls open."
					]
				}
			]
		}
