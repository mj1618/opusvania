						"{\"G\":{\"with\":[\"seize\",\"levy\"],\"without\":[\"seize\",\"levy\"],\"info\":true,\"budget\":1000000},\"rect:1536,512,64,256\":{\"with\":[\"seize\",\"levy\"],\"without\":[\"levy\"],\"info\":true,\"budget\":1000000}}"
