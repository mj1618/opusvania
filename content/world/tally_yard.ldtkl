		{
			"__identifier": "notes",
			"__type": "Multilines",
			"__value": "T02. Street stratum (floor 0). The cart jams in the yard gate; seize it. Planks over a static gutter; seize the crates, not your plank. The chair's creak becomes a spring over the yard wall.",
			"__tile": null,
			"defUid": 129,
			"realEditorValues": [
				{
					"id": "V_String",
					"params": [
						"T02. Street stratum (floor 0). The cart jams in the yard gate; seize it. Planks over a static gutter; seize the crates, not your plank. The chair's creak becomes a spring over the yard wall."
					]
				}
			]
		}
