  "marks": {
    "notes": [
      {
        "x": 1600,
        "y": 760,
        "text": "A  burrback under a wick: it sees you only in the light; snuff it and it sleeps"
      },
      {
        "x": 3900,
        "y": 600,
        "text": "B  hawker at a wick: tell, dive, stall (cut it here), climb"
      },
      {
        "x": 6400,
        "y": 1380,
        "text": "C  orb web + weaver: touch = caught (mash), it runs to you and bites; cut strands from outside"
      },
      {
        "x": 9000,
        "y": 1150,
        "text": "D  old burrback: jump its ram, then cut it while it lies on its back (3 cuts); a pogo on its braced shell counts too"
      },
      {
        "x": 11550,
        "y": 450,
        "text": "E  burrback under a lantern (R9)"
      },
      {
        "x": 13750,
        "y": 640,
        "text": "F  hawker on a rhythm through the wick's orbit: catch after its swoop (R8, the crown); carriers from under the lantern into a crack"
      },
      {
        "x": 16600,
        "y": 700,
        "text": "G  glide onto a burrback's ledge (R6)"
      },
      {
        "x": 21000,
        "y": 420,
        "text": "H  dangler over a safe floor: the thread shows, it drops, swings, hangs open; cut the silk to drop it"
      },
      {
        "x": 23300,
        "y": 300,
        "text": "I  burrback on the platform, a dangler over it, the lantern above both (R9)"
      },
      {
        "x": 25400,
        "y": 700,
        "text": "J  glide onto a landing a dangler guards"
      },
      {
        "x": 29600,
        "y": 700,
        "text": "L  a bombardier on a step: bat its droplets back, or come at it from behind / above"
      }
    ]
  },
