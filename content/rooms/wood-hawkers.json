      { "x": 100, "y": 600, "text": "R8 wood-hawkers  PURPOSE: the hawker, and being caught is being prey" },
      {
        "x": 1000,
        "y": 700,
        "text": "WEST: hawker A over the hummocks at W7, a safe floor: read its tell (the reticle), step aside, cut it in its stall"
      },
      {
        "x": 1700,
        "y": 460,
        "text": "W7 wick-hawk 312 over hummock B: a jump-cut from inside the dive lane"
      },
      {
        "x": 2150,
        "y": 700,
        "text": "EAST: the throw gap, framed whole (camera zone throw). W-throw over the tunnel's mouth; hawker B hunts its orbit"
      },
      {
        "x": 2150,
        "y": 740,
        "text": "fast line: jump into its pull, caught; B tells and dives at the orbit: beat free early, throw up-right onto the far ledge (2304)"
      },
      {
        "x": 2150,
        "y": 780,
        "text": "a jump or a glide can't reach the far ledge (224 up, 448 across): the throw, right or up-right, lands on it or past it"
      },
      {
        "x": 2160,
        "y": 1320,
        "text": "THE DARK WAY (Tatter's): its own door (a root hatch 2208-2368, 160 wide, in the near ledge, in frame): down + jump, one drop; the tunnel; up the open shaft at 3520-3712 (a one-way step at 3600, the floor mesh)"
      },
      {
        "x": 2600,
        "y": 1180,
        "text": "the pit under the throw: a miss lands here; a root step (112, 112) back up to the near ledge: a retry ramp, not the dark way"
      },
      { "x": 3020, "y": 660, "text": "the far ledge: snuff W-throw from here with a jump-cut, and B leaves" },
      {
        "x": 3230,
        "y": 840,
        "text": "FIND: the bark in the far ledge's east face hides the MOONLIT HOLLOW (quick wings: beat free in 2)"
      },
      { "x": 3720, "y": 960, "text": "P-dark moon patch" },
      {
        "x": 1000,
        "y": 800,
        "text": "LANDMARK: twin hummocks under the hawker's lane; the oak's bulk behind the west arch"
      }
