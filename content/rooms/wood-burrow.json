    "notes": [
      {
        "x": 200,
        "y": 200,
        "text": "R4 wood-burrow  PURPOSE: the blade against things; light means seen; the throw's aim; the floor gives way"
      },
      {
        "x": 760,
        "y": 1000,
        "text": "S1: the juvenile beetle alone on the dark floor, no lamp near it, walking away: 2 cuts (HK's crawlid)"
      },
      {
        "x": 300,
        "y": 1360,
        "text": "FIND: a bark floor panel by the door (moonlight leaks through its cracks); down-cut it: a pocket with W-pocket and the KEEN BLADE hollow (+20 snuff reach: the high wicks come into reach)"
      },
      {
        "x": 2300,
        "y": 900,
        "text": "S2: W3 hangs over the root step (152 up): a standing up-cut from the step; its pull never reaches the patrol below"
      },
      {
        "x": 1500,
        "y": 1000,
        "text": "burr-first (4 hp, windup 32) patrols F2 in W3's pool; it rams at her on the root step and meets the step's face: wall stun, belly-up (the beetle rule, seen by itself first)"
      },
      { "x": 2440, "y": 1080, "text": "root step 192 at the patrol's east end" },
      {
        "x": 2780,
        "y": 680,
        "text": "no roof over the gap (round 5): the up-right throw needs the air; no jump crosses 640 without wings"
      },
      {
        "x": 2900,
        "y": 980,
        "text": "THE GAP (fast line): W-gap pulls a jump off the root step; caught, beat free UP-RIGHT: thrown onto the high ledge (right alone meets its face)"
      },
      {
        "x": 2900,
        "y": 1420,
        "text": "THE SLOW LINE: the dark floor under the gap (1472), a low tunnel east under F3, root steps up through a hatch"
      },
      {
        "x": 3600,
        "y": 360,
        "text": "W-hi4 wick-high by shelf H, 720 over F3: claws up the trunk to H, then a jump-cut (a lock seen from P1)"
      },
      { "x": 3600, "y": 1000, "text": "P1 moon patch, Tatter ahead of her" },
      {
        "x": 4100,
        "y": 1100,
        "text": "THE WAY DOWN: a bark floor over the hole: hop, down-cut, each cut bounces her (the pogo, learnt free); the third breaks it"
      },
      {
        "x": 100,
        "y": 1160,
        "text": "re-form point: until P1 is rested at, a fade stands her up at the door"
      },
