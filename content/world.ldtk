				{
					"__identifier": "notes",
					"__type": "Multilines",
					"__value": "L3 brief §4.2. Seize the pink partition (H), spring up the 6-tile hall with a pink levy, seize the brown furnace (F1; F2 is optional bulk), then press the plate with a brown slab (route A) or by standing on it heavy (route B), and cut weight to clear the 3-tile exit step. The W strip is white static: it hums but can't be seized.",
					"__tile": null,
					"defUid": 129,
					"realEditorValues": [
						{
							"id": "V_String",
							"params": [
								"L3 brief §4.2. Seize the pink partition (H), spring up the 6-tile hall with a pink levy, seize the brown furnace (F1; F2 is optional bulk), then press the plate with a brown slab (route A) or by standing on it heavy (route B), and cut weight to clear the 3-tile exit step. The W strip is white static: it hums but can't be seized."
							]
						}
					]
				}
